                "multiline": true,
                "name": "code",
                "required": true,
                "show": false,
                "type": "code",
                "value": "from langflow.custom import CustomComponent\nfrom langchain_core.messages import AIMessage\nimport json\n\nHIGH_RISK_TOOLS = {'write_file'}\n\nclass HITLBreakpoint(CustomComponent):\n    display_name = 'HITL Approval Breakpoint'\n    description = 'Pause execution before high-risk tool calls and require human approval. Denied calls return a blocked message to the agent.'\n\n    def build_config(self):\n        return {\n            'tool_call': {'display_name': 'Pending Tool Call', 'required': False},\n            'risk_level': {'display_name': 'Risk Threshold', 'value': 'high', 'options': ['high', 'medium', 'low']},\n        }\n\n    def build(self, tool_call=None, risk_level='high'):\n        # In the Langflow playground, this node surfaces a visual approval dialog.\n        # In the Python CLI agent (agent.py --hitl on), this is graph_nodes/hitl_node.py.\n        if tool_call is None:\n            return AIMessage(content='[HITL] No pending tool call.')\n        text = tool_call.text if hasattr(tool_call, 'text') else str(tool_call)\n        return AIMessage(content=f'[HITL PENDING] Review tool call:\\n{text}\\n\\nApprove or deny in the Playground.')\n"
              }
            },
            "description": "HITL authorization breakpoint. Intercepts high-risk tool calls (write_file) before execution. The operator reviews tool name and arguments and approves or denies. All decisions are logged to logs/hitl_log.jsonl.",
            "display_name": "HITL Approval Breakpoint",
            "documentation": "",
            "base_classes": ["Message"],
            "output_types": ["Message"]
          }
        }
