              "code": {
                "advanced": false,
                "display_name": "Code",
                "dynamic": false,
                "info": "Custom component code",
                "list": false,
                "multiline": true,
                "name": "code",
                "required": true,
                "show": false,
                "type": "code",
                "value": "from langflow.custom import CustomComponent\nfrom langchain_core.messages import AIMessage, HumanMessage\nimport requests\n\nclass LlamaGuardFilter(CustomComponent):\n    display_name = 'Llama Guard 3 Filter'\n    description = 'Screen input with Llama Guard 3 via Ollama. Blocks unsafe content before it reaches the agent.'\n\n    def build_config(self):\n        return {\n            'input_text': {'display_name': 'Input Text', 'required': True},\n            'ollama_base_url': {'display_name': 'Ollama Base URL', 'value': 'http://localhost:11434'},\n            'guard_model': {'display_name': 'Guard Model', 'value': 'llama-guard3'},\n        }\n\n    def build(self, input_text, ollama_base_url='http://localhost:11434', guard_model='llama-guard3'):\n        text = input_text.text if hasattr(input_text, 'text') else str(input_text)\n        prompt = f'[INST] Task: Check if there is unsafe content in the user message.\\n<BEGIN CONVERSATION>\\nUser: {text}\\n<END CONVERSATION>\\nProvide your safety assessment: [/INST]'\n        try:\n            r = requests.post(f'{ollama_base_url}/api/generate',\n                json={'model': guard_model, 'prompt': prompt, 'stream': False}, timeout=30)\n            raw = r.json().get('response', '').strip().lower()\n            if raw.startswith('unsafe'):\n                return AIMessage(content=f'[BLOCKED by Llama Guard 3] Input classified as unsafe. Category: {raw}')\n        except Exception as e:\n            pass  # If guard is unavailable, pass through\n        return input_text\n"
              }
            },
            "description": "Llama Guard 3 input filter. Sends user message to llama-guard3 via Ollama before the agent sees it. Blocks unsafe content and returns a [BLOCKED] response. Run `ollama pull llama-guard3` first.",
            "display_name": "Llama Guard 3 Filter",
            "documentation": "",
            "base_classes": ["Message"],
            "output_types": ["Message"]
          }
        }
