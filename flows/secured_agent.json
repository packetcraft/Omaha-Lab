                "display_name": "Entities to Redact",
                "dynamic": false,
                "info": "Comma-separated Presidio entity types to scrub",
                "list": false,
                "name": "entities",
                "required": false,
                "show": true,
                "type": "str",
                "value": "PERSON,EMAIL_ADDRESS,PHONE_NUMBER,US_SSN,CREDIT_CARD,LOCATION"
              },
              "code": {
                "advanced": false,
                "display_name": "Code",
                "dynamic": false,
                "info": "",
                "list": false,
                "multiline": true,
                "name": "code",
                "required": true,
                "show": false,
                "type": "code",
                "value": "from langflow.custom import CustomComponent\nfrom langchain_core.messages import AIMessage\n\nclass PresidioRedactor(CustomComponent):\n    display_name = 'Presidio PII Redactor'\n    description = 'Redact PII from LLM output using Microsoft Presidio before showing to user.'\n\n    def build_config(self):\n        return {\n            'input_text': {'display_name': 'Agent Response', 'required': True},\n            'entities': {'display_name': 'Entities to Redact', 'value': 'PERSON,EMAIL_ADDRESS,PHONE_NUMBER,US_SSN,CREDIT_CARD'},\n        }\n\n    def build(self, input_text, entities='PERSON,EMAIL_ADDRESS,PHONE_NUMBER,US_SSN,CREDIT_CARD'):\n        from presidio_analyzer import AnalyzerEngine\n        from presidio_anonymizer import AnonymizerEngine\n        text = input_text.text if hasattr(input_text, 'text') else str(input_text)\n        analyzer = AnalyzerEngine()\n        anonymizer = AnonymizerEngine()\n        entity_list = [e.strip() for e in entities.split(',') if e.strip()]\n        results = analyzer.analyze(text=text, entities=entity_list, language='en')\n        redacted = anonymizer.anonymize(text=text, analyzer_results=results).text\n        return AIMessage(content=redacted)\n"
              }
            },
            "description": "Microsoft Presidio PII redaction on agent output. Replaces names, emails, SSNs, phone numbers, and credit card numbers with [TYPE] labels before the response is shown to the user.",
            "display_name": "Presidio PII Redactor",
            "documentation": "",
            "base_classes": ["Message"],
            "output_types": ["Message"]
