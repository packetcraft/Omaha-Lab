              "tool_code": {
                "advanced": false,
                "display_name": "Tool Code",
                "dynamic": false,
                "info": "Only wire this tool to the agent when the selected persona's allowed_tools includes write_file",
                "list": false,
                "multiline": true,
                "name": "tool_code",
                "required": true,
                "show": true,
                "type": "code",
                "value": "from pathlib import Path\nWORKSPACE = Path('workspace').resolve()\n\ndef write_file(filename: str, content: str) -> str:\n    target = (WORKSPACE / filename).resolve()\n    try: target.relative_to(WORKSPACE)\n    except ValueError: return 'Error: path traversal blocked'\n    target.parent.mkdir(parents=True, exist_ok=True)\n    target.write_text(content, encoding='utf-8')\n    return f'Wrote {len(content)} chars to workspace/{filename}'\n"
              }
            },
            "description": "Write file tool — HIGH-RISK. Disconnect this node when using low-risk personas (customer_service, security_analyst).",
