              "tool_code": {
                "advanced": false,
                "display_name": "Tool Code",
                "dynamic": false,
                "info": "Python function. Validates URL against a domain allow-list before fetching.",
                "list": false,
                "multiline": true,
                "name": "tool_code",
                "required": true,
                "show": true,
                "type": "code",
                "value": "import requests\nfrom urllib.parse import urlparse\n\n_ALLOWED = {'api.openweathermap.org', 'duckduckgo.com', 'httpbin.org'}\n\ndef http_get(url: str) -> str:\n    domain = urlparse(url).netloc.lower().lstrip('www.')\n    if domain not in _ALLOWED:\n        return f'Blocked: {domain} is not in the allow-list.'\n    r = requests.get(url, timeout=10)\n    return r.text[:2000]\n"
              }
            },
            "description": "HTTP GET tool with domain allow-list validation.",
            "display_name": "HTTP GET Tool",
            "documentation": "",
            "base_classes": ["Tool"],
