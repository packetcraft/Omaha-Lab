                "value": "Get the current weather for a city. Args: city (str) — city name."
              },
              "return_direct": {
                "advanced": true,
                "display_name": "Return Direct",
                "dynamic": false,
                "info": "Return tool output directly to user without further LLM reasoning",
                "list": false,
                "name": "return_direct",
                "required": false,
                "show": true,
                "type": "bool",
                "value": false
              },
              "tool_code": {
                "advanced": false,
                "display_name": "Tool Code",
                "dynamic": false,
                "info": "Python function implementing the tool. Must accept (city: str) and return str.",
                "list": false,
                "multiline": true,
                "name": "tool_code",
                "required": true,
                "show": true,
                "type": "code",
                "value": "import os, requests\n\ndef get_weather(city: str) -> str:\n    key = os.getenv('WEATHER_API_KEY', '')\n    if not key:\n        return 'Error: WEATHER_API_KEY not set in .env'\n    url = 'https://api.openweathermap.org/data/2.5/weather'\n    r = requests.get(url, params={'q': city, 'appid': key, 'units': 'imperial'}, timeout=10)\n    if r.status_code != 200:\n        return f'Error: {r.status_code} {r.text}'\n    d = r.json()\n    return (f\"{d['name']}: {d['weather'][0]['description']}, \"\n            f\"{d['main']['temp']}°F, humidity {d['main']['humidity']}%\")\n"
              }
            },
            "description": "OpenWeatherMap current weather by city name. Requires WEATHER_API_KEY in .env.",
            "display_name": "Weather Tool",
            "documentation": "",
            "base_classes": ["Tool"],
            "output_types": ["Tool"]
          }
        }
