                "value": "Write content to a file in the workspace/ sandbox. Args: filename (str), content (str). HIGH-RISK — requires HITL approval when guardrails are enabled."
              },
              "return_direct": {
                "advanced": true,
                "display_name": "Return Direct",
                "dynamic": false,
                "info": "",
                "list": false,
                "name": "return_direct",
                "required": false,
