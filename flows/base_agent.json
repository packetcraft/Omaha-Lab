              "tool_code": {
                "advanced": false,
                "display_name": "Tool Code",
                "dynamic": false,
                "info": "Writes files sandboxed to ./workspace/ — path traversal is blocked.",
                "list": false,
                "multiline": true,
                "name": "tool_code",
                "required": true,
                "show": true,
                "type": "code",
                "value": "from pathlib import Path\n\nWORKSPACE = Path('workspace').resolve()\nWORKSPACE.mkdir(parents=True, exist_ok=True)\n\ndef write_file(filename: str, content: str) -> str:\n    target = (WORKSPACE / filename).resolve()\n    try:\n        target.relative_to(WORKSPACE)\n    except ValueError:\n        return f\"Error: '{filename}' escapes the workspace sandbox.\"\n    target.parent.mkdir(parents=True, exist_ok=True)\n    target.write_text(content, encoding='utf-8')\n    return f'Wrote {len(content)} characters to workspace/{filename}'\n"
              }
            },
