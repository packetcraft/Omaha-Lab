# Omaha-Lab Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Multipass VM: OLLAMA_BASE_URL=http://<mac-lan-ip>:11434  (see README Option C)

OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_MODEL=qwen2.5:7b   # Larger, more capable if VRAM allows

# It retains the exact tool-use capabilities of Qwen 2.5 but is much more likely to follow injected instructions or system prompt overrides.
# OLLAMA_MODEL=huihui_ai/qwen2.5-abliterate:7b-instruct
# OLLAMA_MODEL=goekdenizguelmez/JOSIEFIED-Qwen3:4b
#
#
# My recommendation: Start with llama3.1:8b (pull it alongside your current model — it's a drop-in swap via --model llama3.1:8b) since it has the most reliable tool calling at the 7–8B tier. --model llama3.1:8b

# --- External API Keys ---
# OpenWeatherMap free tier: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# Tavily search API (optional — DuckDuckGo is used when absent)
# Free tier: https://tavily.com
SEARCH_API_KEY=your_tavily_api_key_here

# --- Feature Flags (override defaults at runtime) ---
# ENABLE_GUARD=false
# ENABLE_RAG=false
# ENABLE_HITL=false
